# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
PORT=3000

# Cadena de MongoDB Atlas. En Render se configura en el panel, no en el código.
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/diario-gamer?retryWrites=true&w=majority

# Orígenes permitidos, separados por coma. Incluye el frontend local y, en producción, la URL de Render.
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development
